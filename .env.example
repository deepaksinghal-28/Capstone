# ---------------------------------------------------------------------------
# Database Server Monitoring and Performance Analysis System - settings
#
# Copy this file to ".env" in the same folder and adjust if needed.
# Windows Authentication only: NO usernames or passwords belong in this file.
# ---------------------------------------------------------------------------

# --- SQL Server connection -------------------------------------------------
# "localhost" = default instance on this PC. Named instance: localhost\SQLEXPRESS
# SQL_SERVER is used when SQL_SERVERS (below) is empty, and by the command-line tools.
SQL_SERVER=localhost

# All instances the dashboard monitors: "FriendlyName=connection name", separated by ";".
# The sidebar lets you search / switch between them; the first one is the default.
SQL_SERVERS=Primary=localhost;Secondary=localhost\SQLDEV2
# Optional demo of an unreachable server (shows red in Server overview) - leave commented:
# SQL_SERVERS=Primary=localhost;Secondary=localhost\SQLDEV2;Offline demo=no-such-server.invalid
SQL_DATABASE=master
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Encryption: local Shared Memory connection, so encryption is off by default.
# If you set SQL_ENCRYPT=yes, keep SQL_TRUST_SERVER_CERTIFICATE=yes for the
# self-signed certificate of a local development instance.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes

# Seconds to wait for a connection / for a single monitoring query
SQL_LOGIN_TIMEOUT=5
SQL_QUERY_TIMEOUT=30

# Shown as program_name in sys.dm_exec_sessions (lets the app ignore itself)
SQL_APP_NAME=DBMonitor-Capstone

# --- Dashboard ---------------------------------------------------------------
# Seconds a collected snapshot is reused before SQL Server is queried again
DASHBOARD_CACHE_SECONDS=30

# --- Alert thresholds ---------------------------------------------------------
# Transaction log "Percent Log Used" warning level
ALERT_LOG_USED_PCT=75
# A session blocked for longer than this many seconds = prolonged blocking
ALERT_BLOCKING_SECONDS=30
# A request running for longer than this many seconds = long-running query
ALERT_LONG_RUNNING_SECONDS=60

# Backup policy (Module 4)
# Full backup at least every N hours (168 = weekly)
ALERT_FULL_BACKUP_HOURS=168
# Full OR differential backup at least every N hours
ALERT_DATA_BACKUP_HOURS=24
# Transaction-log backup at least every N minutes (FULL / BULK_LOGGED recovery only)
ALERT_LOG_BACKUP_MINUTES=60

# Alerts (Module 5)
# Log "Percent Log Used" at or above this = Critical (ALERT_LOG_USED_PCT = Warning)
ALERT_LOG_USED_CRITICAL_PCT=90
# Look back this many minutes for Windows low-memory notifications
ALERT_MEMORY_WINDOW_MINUTES=15
# Keep resolved alerts for this many days
ALERT_HISTORY_DAYS=7
# Where alert state is stored (SQLite file). Empty = %USERPROFILE%\CapstoneMonitor\alerts.db
# (not under AppData: Windows redirects AppData for programs started from packaged apps)
ALERT_STORE_PATH=
